---
interface Props {
  slug: string;
  title: string;
  titleJa?: string;
  price: string;
  tags: string[];
  pubDate: Date;
}

const { slug, title, titleJa, price, tags, pubDate } = Astro.props;
const displayTitle = titleJa || title;
const dateLabel = pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<article class="article-card" data-tags={tags.join(',')}>
  <a href={`/games/${slug}/`} class="card-title">{displayTitle}</a>
  <div class="card-meta">
    <span class="price">{price}</span>
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
  </div>
  <div class="card-tags">
    {tags.map((tag) => (
      <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
    ))}
  </div>
</article>

<style>
  .article-card {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
  }
  .card-title:hover { color: var(--accent); }
  .card-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0.35rem 0 0.5rem;
  }
  .card-tags { margin-top: 0.25rem; }
</style>
