---
import type { Page } from 'astro';

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

{page.lastPage > 1 && (
  <nav class="pagination" aria-label="ページ送り">
    {page.url.prev
      ? <a class="page-link" href={page.url.prev}>&larr; 新しい記事</a>
      : <span class="page-link disabled">&larr; 新しい記事</span>}
    <span class="page-status">{page.currentPage} / {page.lastPage}</span>
    {page.url.next
      ? <a class="page-link" href={page.url.next}>過去の記事 &rarr;</a>
      : <span class="page-link disabled">過去の記事 &rarr;</span>}
  </nav>
)}

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1.5rem 0;
  }
  .page-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--accent);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .page-link:hover { border-color: var(--accent); background: var(--card-bg); }
  .page-link.disabled { color: var(--muted); pointer-events: none; opacity: 0.5; }
  .page-status { color: var(--muted); font-size: 0.85rem; flex: 0 0 auto; }
  @media (max-width: 480px) {
    .page-link { flex: 1 1 0; padding: 0.5rem 0.5rem; font-size: 0.85rem; }
  }
</style>
