---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { title, titleJa, descriptionJa, price, tags, audienceJa, releaseDate, heroImage, sourceUrl, pubDate, steamAppId, japaneseSupport } = article.data;
const displayTitle = titleJa || title;
const dateLabel = pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' });
const jaLabel = { full: '対応（音声あり）', text: '対応（字幕/UIのみ）', none: '非対応' }[japaneseSupport ?? ''];
---

<BaseLayout title={displayTitle} description={descriptionJa.slice(0, 120)}>
  <article>
    <h1 class="gradient-text">{displayTitle}</h1>
    {titleJa && titleJa !== title && <p class="original-title">原題: {title}</p>}

    {heroImage && (
      <div class="hero-frame">
        <img class="hero" src={heroImage} alt={displayTitle} loading="lazy" />
      </div>
    )}

    <dl class="meta-list">
      <div><dt>価格</dt><dd class="price-value">{price}</dd></div>
      {jaLabel && <div><dt>日本語対応</dt><dd class={japaneseSupport !== 'none' ? 'ja-yes' : ''}>{jaLabel}</dd></div>}
      {releaseDate && <div><dt>発売日</dt><dd>{releaseDate}</dd></div>}
      <div><dt>掲載日</dt><dd><time datetime={pubDate.toISOString()}>{dateLabel}</time></dd></div>
      <div><dt>Steamストア</dt><dd><a class="store-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">appid {steamAppId} で見る &rarr;</a></dd></div>
    </dl>

    <div class="tag-cloud">
      {tags.map((tag) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
      ))}
    </div>

    <h2 class="gradient-text">ゲーム紹介</h2>
    <p>{descriptionJa}</p>

    <h2 class="gradient-text">どんな人におすすめか</h2>
    <p>{audienceJa}</p>

    <p><a class="back-link" href="/">&larr; ホームに戻る</a></p>
  </article>
</BaseLayout>

<style>
  h1 { font-size: 1.6rem; margin-bottom: 0.4rem; }
  h2 { font-size: 1.2rem; font-weight: 700; margin: 2rem 0 0.75rem; }
  .original-title { color: var(--muted); font-size: 0.9rem; margin-top: -0.2rem; }
  .hero-frame {
    margin: 1.25rem 0;
    padding: 3px;
    border-radius: 16px;
    background: var(--gradient-brand);
  }
  .hero {
    display: block;
    width: 100%;
    max-width: 100%;
    border-radius: 13px;
  }
  .meta-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1.25rem;
    margin: 1.25rem 0;
    padding: 1rem 1.1rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .meta-list dt { color: var(--muted); font-size: 0.85rem; }
  .meta-list dd { margin: 0; }
  .price-value { font-family: var(--font-display); font-weight: 700; color: var(--lime); }
  .ja-yes { color: var(--cyan); font-weight: 600; }
  .store-link { font-weight: 700; }
  .tag-cloud { margin-bottom: 1.75rem; }
  .back-link {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
  }
  .back-link:hover { color: var(--cyan); }
</style>
