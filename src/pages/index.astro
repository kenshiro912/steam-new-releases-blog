---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { siteConfig } from '../site.config';
import { getCollection } from 'astro:content';
import { sortArticles } from '../lib/articles';

const HOME_ARTICLE_COUNT = 8;

const allArticles = sortArticles(await getCollection('articles', ({ data }) => !data.draft));

const latestArticles = allArticles.slice(0, HOME_ARTICLE_COUNT);
const hasMore = allArticles.length > HOME_ARTICLE_COUNT;

const tagCounts = new Map<string, number>();
for (const article of allArticles) {
  for (const tag of article.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={siteConfig.title}>
  <section class="search-section">
    <h2 class="gradient-text">フリーワード検索</h2>
    <div id="search"></div>
  </section>

  <section class="tag-section">
    <h2 class="gradient-text">タグで探す</h2>
    <div class="tag-cloud">
      {tags.length === 0 && <p class="muted">まだ記事がありません。</p>}
      {tags.map(([tag, count]) => (
        <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag} ({count})</a>
      ))}
    </div>
  </section>

  <section class="latest-section">
    <div class="latest-header">
      <h2 class="gradient-text">新着記事</h2>
      <input
        type="text"
        id="tag-filter-input"
        placeholder="表示中の記事をタグで絞り込み"
        aria-label="タグで絞り込み"
      />
    </div>
    <div id="latest-list">
      {latestArticles.length === 0 && <p class="muted">新着記事は準備中です。Steam監視スクリプトが新規ゲームを検出すると、ここに自動で追加されます。</p>}
      {latestArticles.map((article) => (
        <ArticleCard
          slug={article.id}
          title={article.data.title}
          titleJa={article.data.titleJa}
          price={article.data.price}
          tags={article.data.tags}
          pubDate={article.data.pubDate}
          heroImage={article.data.heroImage}
          japaneseSupport={article.data.japaneseSupport}
        />
      ))}
    </div>
    {hasMore && (
      <a class="more-link" href="/articles/">記事一覧をもっと見る（全{allArticles.length}件）&rarr;</a>
    )}
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('tag-filter-input') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.article-card'));

  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    for (const card of cards) {
      const tags = (card.dataset.tags ?? '').toLowerCase();
      card.style.display = !query || tags.includes(query) ? '' : 'none';
    }
  });
</script>

<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (window.PagefindUI) {
      new window.PagefindUI({ element: '#search', showSubResults: true });
    }
  });
</script>

<style>
  h2 { font-size: 1.3rem; font-weight: 700; margin: 2.5rem 0 1rem; }
  .search-section h2 { margin-top: 0; }
  .tag-cloud { display: flex; flex-wrap: wrap; }
  .latest-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  #latest-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.1rem;
  }
  #tag-filter-input {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--fg);
    border-radius: 8px;
    padding: 0.55rem 0.8rem;
    font-size: 0.85rem;
    min-width: 220px;
    flex: 1 1 220px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  #tag-filter-input:focus {
    outline: none;
    border-color: var(--cyan);
    box-shadow: 0 0 0.75rem rgba(34, 226, 245, 0.3);
  }
  .muted { color: var(--muted); }
  .more-link {
    display: block;
    text-align: center;
    margin-top: 1.1rem;
    padding: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--fg);
    font-weight: 700;
    font-size: 0.9rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }
  @media (hover: hover) {
    .more-link:hover { border-color: var(--purple); box-shadow: var(--glow-purple); color: var(--cyan); }
  }
  @media (max-width: 480px) {
    #tag-filter-input { min-width: 0; width: 100%; }
  }
</style>
