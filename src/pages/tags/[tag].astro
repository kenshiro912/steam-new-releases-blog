---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allArticles = await getCollection('articles', ({ data }) => !data.draft);
  const tagSet = new Set<string>();
  for (const article of allArticles) {
    for (const tag of article.data.tags) tagSet.add(tag);
  }

  return [...tagSet].map((tag) => ({
    params: { tag },
    props: {
      articles: allArticles
        .filter((a) => a.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag } = Astro.params;
const { articles } = Astro.props;
---

<BaseLayout title={`「${tag}」タグの記事一覧`}>
  <h1>タグ: {tag}</h1>
  <p class="muted">{articles.length}件の記事</p>
  {articles.map((article) => (
    <ArticleCard
      slug={article.id}
      title={article.data.title}
      titleJa={article.data.titleJa}
      price={article.data.price}
      tags={article.data.tags}
      pubDate={article.data.pubDate}
    />
  ))}
  <p><a href="/">&larr; ホームに戻る</a></p>
</BaseLayout>

<style>
  .muted { color: var(--muted); }
</style>
